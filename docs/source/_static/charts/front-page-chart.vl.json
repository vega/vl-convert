{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Illustrative sample data for the front-page VlConvert output preview.",
  "width": 640,
  "height": 300,
  "background": "white",
  "padding": {"left": 18, "top": 14, "right": 18, "bottom": 12},
  "title": {
    "text": "One Vega-Lite Spec, Multiple Outputs",
    "subtitle": "Illustrative sample rendered as SVG, PNG, and PDF",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#5f6b7a",
    "offset": 14
  },
  "data": {
    "values": [
      {"month": "Jan", "charts": 18, "p95_ms": 72},
      {"month": "Feb", "charts": 24, "p95_ms": 68},
      {"month": "Mar", "charts": 31, "p95_ms": 65},
      {"month": "Apr", "charts": 38, "p95_ms": 61},
      {"month": "May", "charts": 42, "p95_ms": 58},
      {"month": "Jun", "charts": 49, "p95_ms": 55}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4,
        "color": "#4c78a8"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": null,
          "axis": {"title": null, "labelAngle": 0, "labelColor": "#3f4a57"}
        },
        "y": {
          "field": "charts",
          "type": "quantitative",
          "title": "sample charts rendered",
          "axis": {"titleColor": "#4c78a8", "labelColor": "#3f4a57"},
          "scale": {"domainMin": 0}
        }
      }
    },
    {
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": null
        },
        "y": {
          "field": "p95_ms",
          "type": "quantitative",
          "title": "sample p95 latency (ms)",
          "axis": {
            "orient": "right",
            "titleColor": "#a33a00",
            "labelColor": "#3f4a57"
          },
          "scale": {"zero": false}
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 7,
            "color": "white"
          }
        },
        {
          "mark": {
            "type": "line",
            "point": {
              "filled": true,
              "size": 90,
              "fill": "#a33a00",
              "stroke": "white",
              "strokeWidth": 2
            },
            "strokeWidth": 3,
            "color": "#a33a00"
          }
        }
      ]
    }
  ],
  "resolve": {"scale": {"y": "independent"}},
  "config": {
    "view": {"stroke": null},
    "axis": {
      "gridColor": "#e7ebf0",
      "tickColor": "#c6ced8",
      "domainColor": "#c6ced8",
      "titleFontSize": 12,
      "labelFontSize": 12
    },
    "font": "sans-serif"
  }
}
