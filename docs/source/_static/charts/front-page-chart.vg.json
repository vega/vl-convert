{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "background": "white",
  "padding": 5,
  "width": 400,
  "height": 220,
  "title": {
    "text": "Charts Rendered per Month",
    "frame": "group"
  },
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "month": "Jan",
          "charts": 18
        },
        {
          "month": "Feb",
          "charts": 24
        },
        {
          "month": "Mar",
          "charts": 31
        },
        {
          "month": "Apr",
          "charts": 38
        },
        {
          "month": "May",
          "charts": 42
        },
        {
          "month": "Jun",
          "charts": 49
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "month"
          ],
          "field": "charts",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "charts_start",
            "charts_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"charts\"]) && isFinite(+datum[\"charts\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"month: \" + (isValid(datum[\"month\"]) ? isArray(datum[\"month\"]) ? join(datum[\"month\"], ' ') : datum[\"month\"] : \"\"+datum[\"month\"]) + \"; charts: \" + (format(datum[\"charts\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "month"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "charts_end"
          },
          "y2": {
            "scale": "y",
            "field": "charts_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "month"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "charts_start",
          "charts_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "month",
      "labelAngle": 0,
      "labelBaseline": "top",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "charts",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}