{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "values": [
      {"category": "A", "value": 2},
      {"category": "B", "value": 5}
    ]
  },
  "transform": [
    {"calculate": "doubleValue(datum.value)", "as": "doubled"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {"field": "category", "type": "nominal"},
    "y": {"field": "doubled", "type": "quantitative"}
  }
}
